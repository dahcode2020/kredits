{
  "name": "kredit-frontend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000 -H 0.0.0.0",
    "build": "next build",
    "start": "next start -p 3000 -H 0.0.0.0",
    "lint": "next lint --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:unit": "jest --testPathPattern='tests/unit'",
    "check:hydration": "node scripts/check-hydration.mjs && node scripts/check-dom-nesting.mjs",
    "check:copy": "node scripts/check-copy.mjs",
    "check:copy:update": "node scripts/check-copy.mjs --update",
    "check:links": "node scripts/check-routes.mjs",
    "check:assets": "node scripts/check-assets.mjs",
    "check:state": "node scripts/check-state.mjs",
    "check": "npm run typecheck && npm run check:hydration && npm run check:copy && npm run check:links",
    "fresh": "node scripts/fresh.mjs"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "decimal.js": "10.4.3",
    "libphonenumber-js": "1.13.13",
    "lucide-react": "0.469.0",
    "next": "^14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tailwind-merge": "2.5.4"
  },
  "devDependencies": {
    "@types/jest": "29.5.14",
    "@types/node": "22.10.1",
    "@types/react": "18.3.5",
    "@types/react-dom": "18.3.0",
    "autoprefixer": "10.4.20",
    "eslint": "8.57.1",
    "eslint-config-next": "14.2.15",
    "jest": "29.7.0",
    "jest-environment-jsdom": "29.7.0",
    "jsdom": "24.1.3",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.17",
    "ts-jest": "29.2.5",
    "typescript": "5.7.2"
  }
}
